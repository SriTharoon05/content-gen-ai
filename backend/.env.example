# Only bootstrap values live here. Everything else is edited in the dashboard and stored in the DB.

DATABASE_URL=postgresql+psycopg://postgres:pass@db.xxxx.supabase.co:5432/postgres

# Optional Supabase Storage (use the server-side service-role key only here).
SUPABASE_URL=
SUPABASE_KEY=

OUTPUT_DIR=./outputs
WORK_DIR=./data/work
MEDIA_DIR=./data/media
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_ENV=development
RUN_WORKER=1
RUN_SCHEDULER=1

# Optional: if set, every write endpoint requires  Authorization: Bearer <token>
ADMIN_TOKEN=

# Seeded into the settings table on first boot only. After that, edit them in the dashboard.
GEMINI_FREE_KEYS=
GEMINI_PAID_KEYS=
GEMINI_AUDIO_PAID_KEY=
POLLINATIONS_API_KEYS=
GROQ_API_KEYS=

# External wakeups: use the same random value in Supabase Vault.
SCHEDULER_TOKEN=
RENDER_PUBLIC_URL=https://your-api.onrender.com
# Set a real operator contact per Wikimedia's API etiquette before deployment.
WIKIMEDIA_USER_AGENT=StoryShorts/1.0 (mailto:you@example.com)
# Optional; without this, exact-term grounding searches use official Wikipedia.
SERPAPI_KEY=

# Optional social connections. Never expose these via VITE_ environment variables.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET are also accepted aliases.
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Optional dedicated Fernet key; set before connecting channels and keep stable.
# Without this, token encryption derives from the Google client secret.
OAUTH_ENCRYPTION_KEY=
INSTAGRAM_GRAPH_VERSION=v25.0
# Direct Instagram Login: use the Instagram App ID/Secret from Instagram API setup.
# Professional account required; no Facebook Page or Facebook Login.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://story-shorts-api.onrender.com/auth/meta/callback
# META_API_VERSION is also accepted; do not set conflicting version aliases.
# Tokens are encrypted per channel. Without OAUTH_ENCRYPTION_KEY, Meta uses META_APP_SECRET.
# Keep encryption configuration stable or reconnect accounts after rotating it.
# Map each channel explicitly to avoid uploading all five brands to one account.
SOCIAL_CHANNELS_JSON={"talemorrow":{"youtube_refresh_token":""}}
